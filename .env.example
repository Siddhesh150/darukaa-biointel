# ---------------------------------------------------------------------------
# Darukaa.Earth BioIntel - configuration
#
# EVERY value below has a working default. The system runs with this file
# absent, with no API key and with no network access.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- database --------------------------------------------------------------
# Default: SQLite, created automatically at data/biointel.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://biointel:biointel@localhost:5432/biointel
# DATABASE_URL=

# --- retrieval -------------------------------------------------------------
# hashing               deterministic offline embeddings, zero downloads (default)
# sentence_transformers local model, needs `pip install sentence-transformers`
# openai                hosted, needs LLM_API_KEY
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=512
VECTOR_STORE=numpy          # numpy | pgvector
RETRIEVAL_TOP_K=8

# hybrid fusion weights (must be tuned together)
W_DENSE=0.45
W_LEXICAL=0.25
W_VARIABLE_OVERLAP=0.20
W_SOURCE_QUALITY=0.10

# --- LLM narration (optional) ---------------------------------------------
# none      deterministic template narrator - fully functional (default)
# openai | anthropic | ollama
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_TIMEOUT_S=45
LLM_MAX_TOKENS=1200

# --- reasoning behaviour ---------------------------------------------------
MAX_RECOMMENDATIONS=3
MIN_VARIABLES_FOR_RECOMMENDATION=3
MIN_SCORE_TO_RECOMMEND=0.32
MAX_CLARIFYING_QUESTIONS=3
STRICT_CLAIM_VALIDATION=true
ENABLE_GEOSPATIAL=true

# --- recommendation scoring weights (must sum to 1.0) ----------------------
W_MULTI_METRIC_FIT=0.30
W_EVIDENCE_STRENGTH=0.25
W_IMPACT_POTENTIAL=0.20
W_CONTEXT_FIT=0.10
W_FEASIBILITY=0.10
W_CO_BENEFIT=0.05

# --- service limits --------------------------------------------------------
MAX_REQUEST_BYTES=262144
RATE_LIMIT_PER_MINUTE=60
